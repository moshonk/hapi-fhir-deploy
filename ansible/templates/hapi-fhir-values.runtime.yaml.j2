{% if enable_pgbouncer | default(false) | bool %}
{% set datasource_host = pgbouncer_service_name + '.' + hapi_namespace + '.svc.cluster.local' %}
{% set datasource_port = pgbouncer_listen_port %}
{% else %}
{% set datasource_host = lab_database_endpoint %}
{% set datasource_port = lab_database_port %}
{% endif %}
hapi-fhir-jpaserver:
{% if hapi_cpu_request | default('') | string | trim | length > 0 %}
  # Per-lab CPU request override (hapi_cpu_request); only requests.cpu is
  # set, so Helm's map merge keeps the chart's memory request and both
  # limits. The chart default (500m) understates real usage: under the T3
  # load shape on hapi-lab-t4 (2026-09-12) HAPI pods used 1.3-1.6 cores
  # each while requesting 500m, so 8 replicas packed onto 3 nodes at
  # 101% CPU with 0 pods Pending -- and the cluster autoscaler, which only
  # reacts to Pending pods, never added nodes despite a max of 6.
  resources:
    requests:
      cpu: "{{ hapi_cpu_request | string | trim }}"
{% endif %}
  # When enable_pgbouncer is true, HAPI's datasource points at the
  # PgBouncer Service (specs/007-pgbouncer-connection-pooling) instead of
  # the raw PostgreSQL endpoint; PgBouncer itself connects upstream to
  # lab_database_endpoint (see pgbouncer-deployment.runtime.yaml.j2).
  # Disabled (the default), this block is byte-for-byte what it was before
  # spec 007: the native tier is unaffected.
  externalDatabase:
    host: "{{ datasource_host }}"
    port: {{ datasource_port }}
    user: "{{ lab_database_username }}"
    database: "{{ lab_database_name }}"
    existingSecret: "{{ hapi_database_secret_name }}"
    existingSecretKey: "{{ hapi_database_secret_key }}"

  extraEnv:
    - name: JAVA_TOOL_OPTIONS
      value: "-XX:MaxRAMPercentage=75 -XX:+UseG1GC -XX:MaxGCPauseMillis=200"
    - name: SERVER_SHUTDOWN
      value: graceful
    - name: HAPI_FHIR_POSTGRES_JDBC_URL
      value: "jdbc:postgresql://{{ datasource_host }}:{{ datasource_port }}/{{ lab_database_name }}"
    - name: HAPI_FHIR_POSTGRES_USERNAME
      value: "{{ lab_database_username }}"
    - name: HAPI_FHIR_POSTGRES_PASSWORD
      valueFrom:
        secretKeyRef:
          name: "{{ hapi_database_secret_name }}"
          key: "{{ hapi_database_secret_key }}"
{% if hapi_tomcat_max_threads | default('') | string | trim | length > 0 %}
    # Per-lab Tomcat worker-thread cap (hapi_tomcat_max_threads); blank keeps
    # Tomcat's default of 200. On hapi-lab-t4 (2026-09-13) single HAPI pods
    # repeatedly jammed under T3 load: 200 requests in flight, all 20 Hikari
    # connections checked out with ~177 threads queued behind them, CPU
    # throttled 60-74% at the 2-core limit, ~1.8s mean -- while the other
    # pods sat at 2-8 in flight and ~40ms. A cap near the pool size stops a
    # pod piling hundreds of threads onto two cores; Tomcat's NIO connector
    # keeps excess connections queued without holding a thread.
    - name: SERVER_TOMCAT_THREADS_MAX
      value: "{{ hapi_tomcat_max_threads | string | trim }}"
{% endif %}
