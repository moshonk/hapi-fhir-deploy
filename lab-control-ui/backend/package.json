{
  "name": "lab-control-ui-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for the Lab Control UI (specs/009-lab-control-ui) - shells out to scripts/lab.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "format": "prettier --check src test"
  },
  "dependencies": {
    "express": "5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/express": "5.0.6",
    "@types/node": "22.19.2",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.1",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "4.1.10"
  }
}
