# Copy to .env (gitignored) and fill in before `docker compose up`.
# docker-compose.yml refuses to start the app service without
# LAB_UI_SHARED_SECRET -- there is deliberately no default.

# Required. Login credential (FR-013/014/015). Generate one, e.g.:
#   openssl rand -base64 24
LAB_UI_SHARED_SECRET=

# Host port nginx binds. Change to e.g. 8080 if 80 is already taken on this host.
HTTP_PORT=80

# Path to your GCP Application Default Credentials directory, mounted
# read-only into the app container. Run `gcloud auth application-default
# login` on the HOST first (not inside the container) -- this just makes
# that login visible to the container. Defaults to $HOME/.config/gcloud;
# override with an ABSOLUTE path if yours lives elsewhere -- Docker Compose
# does not expand a leading `~`.
# GCLOUD_CONFIG_DIR=/home/youruser/.config/gcloud

# Set to true only once nginx is actually terminating HTTPS (see
# nginx/nginx.conf's commented-out TLS server block) -- until then, leave
# false so the session cookie isn't marked Secure on a plain-HTTP deployment
# (which would make the browser silently refuse to send it back).
LAB_UI_COOKIE_SECURE=false
