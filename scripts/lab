#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ARTIFACT_ROOT="${LAB_ARTIFACTS_DIR:-$ROOT_DIR/ansible/artifacts/lab}"
RUN_ROOT="${LAB_RUNS_DIR:-$ARTIFACT_ROOT/runs}"
RESULT_ROOT="${LAB_RESULTS_DIR:-$ROOT_DIR/results}"

COMMAND="${1:-}"
if [[ -n "$COMMAND" ]]; then
  shift
fi

CLOUD=""
NAME=""
RUN_ID=""
PATIENTS=""
SEED=""
PROFILE=""
ECHIS_TIER=""
HOUSEHOLDS=""
INDIVIDUALS_PER_HOUSEHOLD=""
PARALLEL_SHARDS=""
IN_CLUSTER=false
REPLICAS=""
PORT=""
SOURCE_RANGES=""
AUTO_APPROVE=false
YES=false
DRY_RUN=false
GENERATE_ONLY=false
TF_VARS=()
ANSIBLE_EXTRA_VARS=()
SEED_GENERATOR_MODE="${LAB_SEED_GENERATOR_MODE:-synthea}"

usage() {
  cat <<'USAGE'
Usage:
  scripts/lab up --cloud aws|azure|gcp --name NAME [--auto-approve] [--var key=value]
  scripts/lab deploy --cloud aws|azure|gcp --name NAME [--extra-vars key=value]
  scripts/lab seed --patients N --seed S [--run RUN_ID] [--generate-only]
  scripts/lab seed --households N --seed S [--individuals-per-household N] [--run RUN_ID] [--generate-only]
    (LAB_SEED_GENERATOR_MODE=native; add --in-cluster --parallel-shards N to run
    scripts/echis_seed.rb as a distributed Kubernetes Indexed Job instead of a
    single local process)
  scripts/lab benchmark --profile smoke|baseline|load|stress [--echis-tier T2|T3|T4|T5] [--run RUN_ID]
    (add --in-cluster --parallel-shards N to run benchmarks/k6/echis_load_100.js
    as a distributed Kubernetes Indexed Job instead of a single local k6 process)
  scripts/lab report --run RUN_ID [--cloud aws|azure|gcp] [--name NAME] [--profile smoke|baseline|load|stress]
  scripts/lab down --cloud aws|azure|gcp --name NAME [--yes]
  scripts/lab pause-autoscaling --replicas N
  scripts/lab resume-autoscaling
  scripts/lab expose-fhir --cloud gcp --name NAME --var project_id=P [--port 8080] [--source-ranges CIDR[,CIDR...]]
  scripts/lab unexpose-fhir --cloud gcp --name NAME --var project_id=P
  scripts/lab expose-prometheus --cloud gcp --name NAME --var project_id=P [--port 9090] [--source-ranges CIDR[,CIDR...]]
  scripts/lab unexpose-prometheus --cloud gcp --name NAME --var project_id=P
  scripts/lab expose-grafana --cloud gcp --name NAME --var project_id=P [--port 3000] [--source-ranges CIDR[,CIDR...]]
  scripts/lab unexpose-grafana --cloud gcp --name NAME --var project_id=P

Commands:
  up                  Provision cloud infrastructure with Terraform and save ignored local outputs.
  deploy               Run the provider-neutral Ansible deployment workflow.
  seed                 Generate deterministic Synthea FHIR data and optionally invoke a loader.
  benchmark            Run a k6 FHIR benchmark profile.
  report               Publish local benchmark result artifacts from a run directory.
  down                 Destroy cloud infrastructure. Use this promptly to control cloud cost.
  pause-autoscaling    Pin the KEDA-managed replica count to N for a bulk data-load window
                       (see docs/autoscaling.md's "Bulk Data-Load Window Procedure").
  resume-autoscaling   Remove the pin so KEDA resumes live-metric-driven autoscaling.
  expose-fhir          GCP only. Open a firewall rule and a 0.0.0.0-bound `kubectl port-forward`
                       so HAPI FHIR is reachable at http://EXTERNAL_IP:PORT/fhir from outside the
                       control-plane host running `scripts/lab`, not just via SSH/VS Code tunnels.
                       --source-ranges defaults to 0.0.0.0/0 (the whole internet) -- HAPI FHIR has
                       no auth in front of it in this lab, know what you're opting into. Pass
                       --source-ranges CIDR (e.g. your own IP/32) to restrict it; auto-detecting a
                       "caller" IP isn't a safe default here since `scripts/lab` normally runs on
                       the GCE VM itself, not on the machine whose browser needs access.
                       `down` calls this same cleanup automatically, but run it yourself to close
                       exposure early without tearing down the whole lab.
  unexpose-fhir        GCP only. Reverse of expose-fhir: kill the tracked port-forward and delete
                       the firewall rule. Safe to run even if nothing is currently exposed.
  expose-prometheus    GCP only. Same as expose-fhir, for the kube-prometheus-stack Prometheus
                       Service (default port 9090) 00-install-addons.yml installs instead.
  unexpose-prometheus  GCP only. Reverse of expose-prometheus. Safe to run even if nothing is
                       currently exposed.
  expose-grafana       GCP only. Same as expose-fhir, for the kube-prometheus-stack Grafana
                       Service (Service port 80, exposed locally on 3000 by default since
                       binding 80 needs root) 00-install-addons.yml installs when
                       install_grafana is true. Login is required (unlike FHIR/Prometheus,
                       which have no auth at all): user "admin", password from
                       `kubectl -n monitoring get secret prometheus-grafana -o
                       jsonpath='{.data.admin-password}' | base64 -d`.
  unexpose-grafana     GCP only. Reverse of expose-grafana. Safe to run even if nothing is
                       currently exposed.

Environment:
  LAB_ARTIFACTS_DIR       Artifact root; defaults to ansible/artifacts/lab.
  TERRAFORM_BIN           Terraform executable; defaults to terraform.
  LAB_SKIP_PREFLIGHT      `up` only. Defaults to false: `up` checks the whole lab
                          lifecycle's toolchain (not just what `up` itself needs)
                          before provisioning anything, so a missing `deploy`/
                          `seed`/`benchmark` prerequisite is a fast failure instead
                          of a surprise after 10+ minutes of billable cluster
                          creation. Set to true to skip this check.
  LAB_TF_AUTO_IMPORT      `up` only. Defaults to true: if apply fails because a
                          resource already exists in the cloud but isn't yet in
                          this workspace's Terraform state (e.g. left behind by
                          a prior interrupted `up`, or an incomplete `down`),
                          import it and retry instead of failing outright. Set
                          to false to restore the old strict-fail behavior.
  ANSIBLE_PLAYBOOK_BIN    ansible-playbook executable; defaults to ansible-playbook.
  ANSIBLE_GALAXY_BIN      ansible-galaxy executable; defaults to ansible-galaxy.
  LAB_KUBECONFIG          Explicit kubeconfig path for deploy; otherwise uses generated lab kubeconfig.
  SYNTHEA_CMD             Synthea executable path; otherwise synthea or $SYNTHEA_HOME/run_synthea.
  SYNTHEA_CONFIG          Synthea properties file; defaults to benchmarks/synthea/synthea.properties.
  LAB_SEED_LOADER_CMD     Synthea-mode loader command; defaults to scripts/synthea_loader.rb.
                          Only used when LAB_SEED_GENERATOR_MODE=synthea (the default).
  LAB_ECHIS_SEED_CMD      Native-mode eCHIS generator command; defaults to
                          scripts/echis_seed.rb. Only used when
                          LAB_SEED_GENERATOR_MODE=native -- a distinct env var from
                          LAB_SEED_LOADER_CMD so overriding one mode's command can't
                          accidentally get invoked with the other mode's flags.
  FHIR_BASE_URL           HAPI FHIR endpoint for seed loading and k6 benchmarks.
  K6_BIN                  k6 executable; defaults to k6.
  K6_SCRIPT               k6 script path; defaults to benchmarks/k6/PROFILE.js.
  PROMETHEUS_BASE_URL     Required by baseline profile gates for pod restart and Hikari checks.
  LAB_RESULTS_DIR         Published result root; defaults to results/.
  LAB_RESULT_PUBLISHER_CMD Optional publisher command; defaults to scripts/publish_results.rb.
  LAB_REPORT_CMD          Legacy report command invoked as: CMD RUN_DIR REPORT_PATH.
  LAB_ECHIS_POOLED_TIER_CONFIRMED
                          Set to "true" to attest the PgBouncer pooled tier (spec 007,
                          enable_pgbouncer: true) is deployed and validated; required by
                          --echis-tier T4 or T5.
  LAB_SEED_GENERATOR_MODE
                          synthea (default, existing behavior unchanged) or native
                          (invokes scripts/echis_seed.rb directly with --households,
                          skipping Synthea entirely; requires --households not
                          --patients).
  KUBECTL_BIN             kubectl executable; defaults to kubectl. Used by --in-cluster,
                          pause-autoscaling, and resume-autoscaling.
  LAB_SHARD_OUTPUT_PVC    PersistentVolumeClaim name shard pods mount for output;
                          defaults to echis-shard-output. Used by --in-cluster.
  HAPI_NAMESPACE          Kubernetes namespace for the HAPI FHIR deployment; defaults
                          to fhir. Used by pause-autoscaling, resume-autoscaling,
                          expose-fhir, and unexpose-fhir.
  HAPI_SERVICE_NAME       HAPI FHIR Kubernetes Service name; defaults to
                          hapi-fhir-hapi-fhir-jpaserver. Used by expose-fhir.
  PROMETHEUS_NAMESPACE    Kubernetes namespace for kube-prometheus-stack; defaults to
                          monitoring. Used by expose-prometheus and unexpose-prometheus.
  PROMETHEUS_SERVICE_NAME Prometheus Kubernetes Service name; defaults to
                          prometheus-kube-prometheus-prometheus. Used by expose-prometheus.
  GRAFANA_NAMESPACE       Kubernetes namespace for Grafana; defaults to monitoring.
                          Used by expose-grafana and unexpose-grafana.
  GRAFANA_SERVICE_NAME    Grafana Kubernetes Service name; defaults to prometheus-grafana.
                          Used by expose-grafana.
USAGE
}

die() {
  printf 'scripts/lab: %s\n' "$*" >&2
  exit 1
}

log() {
  printf '==> %s\n' "$*" >&2
}

run() {
  printf '+'
  printf ' %q' "$@"
  printf '\n'
  if [[ "$DRY_RUN" == true ]]; then
    return 0
  fi
  "$@"
}

need_command() {
  if [[ "$1" == */* ]]; then
    [[ -x "$1" ]] || die "required executable path not found or not executable: $1"
    return 0
  fi
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

need_command_unless_dry_run() {
  if [[ "$DRY_RUN" == true && ! -x "$1" ]] && ! command -v "$1" >/dev/null 2>&1; then
    log "Dry run: skipping missing command check for $1"
    return 0
  fi
  need_command "$1"
}

timestamp() {
  date -u +%Y%m%d-%H%M%S
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cloud)
        CLOUD="${2:-}"
        shift 2
        ;;
      --name)
        NAME="${2:-}"
        shift 2
        ;;
      --run)
        RUN_ID="${2:-}"
        shift 2
        ;;
      --patients)
        PATIENTS="${2:-}"
        shift 2
        ;;
      --seed)
        SEED="${2:-}"
        shift 2
        ;;
      --profile)
        PROFILE="${2:-}"
        shift 2
        ;;
      --echis-tier)
        [[ -n "${2:-}" ]] || die "--echis-tier requires a value (T2, T3, T4, or T5)"
        ECHIS_TIER="$2"
        shift 2
        ;;
      --households)
        [[ -n "${2:-}" ]] || die "--households requires a value"
        HOUSEHOLDS="$2"
        shift 2
        ;;
      --individuals-per-household)
        [[ -n "${2:-}" ]] || die "--individuals-per-household requires a value"
        INDIVIDUALS_PER_HOUSEHOLD="$2"
        shift 2
        ;;
      --parallel-shards)
        [[ -n "${2:-}" ]] || die "--parallel-shards requires a value"
        PARALLEL_SHARDS="$2"
        shift 2
        ;;
      --in-cluster)
        IN_CLUSTER=true
        shift
        ;;
      --replicas)
        [[ -n "${2:-}" ]] || die "--replicas requires a value"
        REPLICAS="$2"
        shift 2
        ;;
      --port)
        [[ -n "${2:-}" ]] || die "--port requires a value"
        PORT="$2"
        shift 2
        ;;
      --source-ranges)
        [[ -n "${2:-}" ]] || die "--source-ranges requires a value"
        SOURCE_RANGES="$2"
        shift 2
        ;;
      --auto-approve)
        AUTO_APPROVE=true
        shift
        ;;
      --yes)
        YES=true
        shift
        ;;
      --dry-run)
        DRY_RUN=true
        shift
        ;;
      --generate-only)
        GENERATE_ONLY=true
        shift
        ;;
      --var|--terraform-var)
        TF_VARS+=("-var" "${2:-}")
        shift 2
        ;;
      --extra-vars)
        ANSIBLE_EXTRA_VARS+=("-e" "${2:-}")
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "unknown argument: $1"
        ;;
    esac
  done
}

require_cloud() {
  case "$CLOUD" in
    aws|azure|gcp) ;;
    "") die "--cloud is required and must be aws, azure, or gcp" ;;
    *) die "unsupported cloud '$CLOUD'; expected aws, azure, or gcp" ;;
  esac
}

require_name() {
  [[ -n "$NAME" ]] || die "--name is required"
  [[ "$NAME" =~ ^[a-z][a-z0-9-]{2,31}$ ]] || die "--name must match Terraform lab_name: ^[a-z][a-z0-9-]{2,31}$"
}

require_run() {
  [[ -n "$RUN_ID" ]] || die "--run is required"
  validate_run_id
}

validate_run_id() {
  [[ -n "$RUN_ID" ]] || die "--run is required"
  [[ "$RUN_ID" =~ ^[A-Za-z0-9._-]+$ ]] || die "--run must contain only letters, numbers, dots, underscores, or hyphens"
  [[ "$RUN_ID" != "." && "$RUN_ID" != ".." ]] || die "--run cannot be '.' or '..'"
}

require_profile() {
  case "$PROFILE" in
    smoke|baseline|load|stress) ;;
    "") die "--profile is required and must be smoke, baseline, load, or stress" ;;
    *) die "unsupported profile '$PROFILE'; expected smoke, baseline, load, or stress" ;;
  esac
}

state_dir() {
  printf '%s/%s/%s' "$ARTIFACT_ROOT" "$CLOUD" "$NAME"
}

run_dir() {
  printf '%s/%s' "$RUN_ROOT" "$RUN_ID"
}

terraform_bin() {
  printf '%s' "${TERRAFORM_BIN:-terraform}"
}

terraform_dir() {
  printf '%s/infra/terraform/%s' "$ROOT_DIR" "$CLOUD"
}

terraform_workspace_ensure() {
  local tf_bin="$1"
  local tf_dir="$2"

  if [[ "$DRY_RUN" == true ]]; then
    run "$tf_bin" -chdir="$tf_dir" workspace select "$NAME"
    return 0
  fi

  if ! "$tf_bin" -chdir="$tf_dir" workspace select "$NAME" >/dev/null 2>&1; then
    run "$tf_bin" -chdir="$tf_dir" workspace new "$NAME"
  else
    run "$tf_bin" -chdir="$tf_dir" workspace select "$NAME"
  fi
}

terraform_workspace_select() {
  local tf_bin="$1"
  local tf_dir="$2"

  if [[ "$DRY_RUN" == true ]]; then
    run "$tf_bin" -chdir="$tf_dir" workspace select "$NAME"
    return 0
  fi

  "$tf_bin" -chdir="$tf_dir" workspace select "$NAME" >/dev/null 2>&1 ||
    die "Terraform workspace '$NAME' does not exist for $CLOUD; run up first or choose the correct --name"
  run "$tf_bin" -chdir="$tf_dir" workspace select "$NAME"
}

write_terraform_outputs() {
  local tf_bin="$1"
  local tf_dir="$2"
  local dir="$3"
  local output_file="$dir/terraform-output.json"
  local kubeconfig_file="$dir/kubeconfig"

  if [[ "$DRY_RUN" == true ]]; then
    log "Would write Terraform outputs to $output_file and $kubeconfig_file"
    return 0
  fi

  "$tf_bin" -chdir="$tf_dir" output -json >"$output_file"
  "$tf_bin" -chdir="$tf_dir" output -raw kubeconfig >"$kubeconfig_file"
  chmod 600 "$kubeconfig_file"
  log "Wrote ignored Terraform outputs to $output_file"
  log "Wrote ignored kubeconfig to $kubeconfig_file"
}

# up only: whether to auto-reuse a pre-existing cloud resource that isn't
# yet tracked in this workspace's Terraform state, instead of failing apply.
TF_AUTO_IMPORT="${LAB_TF_AUTO_IMPORT:-true}"

# up only: whether to skip the whole-lifecycle prerequisites check before
# provisioning. See check_lab_prerequisites.
LAB_SKIP_PREFLIGHT="${LAB_SKIP_PREFLIGHT:-false}"

terraform_state_has_resource() {
  local tf_bin="$1" tf_dir="$2" addr="$3"
  "$tf_bin" -chdir="$tf_dir" state list 2>/dev/null | grep -qxF "$addr"
}

# Looks up the value most recently supplied via --var/--terraform-var
# "key=value". Prints nothing and fails if key was never supplied.
tf_var_get() {
  local key="$1"
  local i
  for ((i = ${#TF_VARS[@]} - 1; i >= 0; i--)); do
    [[ "${TF_VARS[$i]}" == "-var" ]] || continue
    local kv="${TF_VARS[$((i + 1))]:-}"
    if [[ "$kv" == "$key="* ]]; then
      printf '%s' "${kv#"$key"=}"
      return 0
    fi
  done
  return 1
}

# infra/terraform/gcp/main.tf's private-services-access peering
# (google_service_networking_connection.private_service) doesn't surface a
# parseable "already exists" error on re-create the way the other resources
# below do -- the servicenetworking API rejects a conflicting create with a
# different error shape entirely. Reconcile it proactively, before apply,
# rather than relying on the generic retry-and-import path.
gcp_reuse_service_networking_connection() {
  local tf_bin="$1" tf_dir="$2"
  shift 2
  local var_args=("$@")

  [[ "$DRY_RUN" == true ]] && return 0

  local addr="google_service_networking_connection.private_service"
  terraform_state_has_resource "$tf_bin" "$tf_dir" "$addr" && return 0

  local project_id
  project_id="$(tf_var_get project_id)" || return 0
  [[ -n "$project_id" ]] || return 0

  local import_id="projects/${project_id}/global/networks/${NAME}:servicenetworking.googleapis.com"
  if "$tf_bin" -chdir="$tf_dir" import "${var_args[@]}" "$addr" "$import_id" >/dev/null 2>&1; then
    log "Reused existing GCP private-services-access connection for '$NAME' (was not tracked in this workspace's state)."
  fi
  # Otherwise the connection genuinely doesn't exist yet; apply will create it.
}

# infra/terraform/gcp/main.tf's Cloud SQL instance
# (google_sql_database_instance.postgres) has been observed to finish
# creating successfully on the API side while `terraform apply` still fails,
# because the provider's operation-wait call can die with an opaque,
# message-less "Error waiting for Create Instance: " -- known
# terraform-provider-google flakiness on long-running Cloud SQL operations.
# That error text has no 'ID' already exists to match, so
# parse_apply_conflicts never fires for it and the instance is silently
# orphaned outside Terraform state; the next `up` then hits a real "already
# exists" 409. Reconcile it proactively, before apply, the same way
# gcp_reuse_service_networking_connection does above -- ask the Cloud SQL
# Admin API directly whether the instance already exists rather than relying
# on apply's error text.
gcp_reuse_sql_database_instance() {
  local tf_bin="$1" tf_dir="$2"
  shift 2
  local var_args=("$@")

  [[ "$DRY_RUN" == true ]] && return 0

  local addr="google_sql_database_instance.postgres"
  terraform_state_has_resource "$tf_bin" "$tf_dir" "$addr" && return 0

  local project_id
  project_id="$(tf_var_get project_id)" || return 0
  [[ -n "$project_id" ]] || return 0

  command -v gcloud >/dev/null 2>&1 || return 0
  command -v curl >/dev/null 2>&1 || return 0

  local token
  token="$(gcloud auth application-default print-access-token 2>/dev/null)" || return 0
  [[ -n "$token" ]] || return 0

  local instance_name="${NAME}-postgres"
  local instance_json
  instance_json="$(curl -fsS --max-time 15 \
    -H "Authorization: Bearer $token" \
    "https://sqladmin.googleapis.com/sql/v1beta4/projects/${project_id}/instances/${instance_name}" 2>/dev/null)" || return 0
  [[ -n "$instance_json" ]] || return 0

  # Only reuse an instance the API reports as actually present (has a
  # "state" field, e.g. RUNNABLE) -- a 404 body has none, so this also
  # covers the common case where the instance genuinely doesn't exist yet.
  # A plain sed extraction (not ruby -rjson, unlike the rest of this file)
  # keeps `up` free of the Ruby prerequisite the other subcommands need.
  local instance_state
  instance_state="$(printf '%s\n' "$instance_json" | sed -n 's/.*"state": *"\([A-Z_]*\)".*/\1/p' | head -n1)"
  [[ -n "$instance_state" ]] || return 0

  local import_id="${project_id}/${instance_name}"
  if "$tf_bin" -chdir="$tf_dir" import "${var_args[@]}" "$addr" "$import_id" >/dev/null 2>&1; then
    log "Reused existing GCP Cloud SQL instance '$instance_name' for '$NAME' (was not tracked in this workspace's state -- likely left behind by a prior apply whose operation-wait failed after the instance actually finished creating)."
  fi
  # Otherwise the instance genuinely doesn't exist yet; apply will create it.
}

# Extracts tab-separated "<error summary>\t<resource address>" pairs from a
# `terraform apply` log, one per "Error: ... 'ID' already exists" block --
# Terraform's standard shape for a provider create call that conflicts with
# a real cloud resource not present in this workspace's state.
parse_apply_conflicts() {
  awk '
    /^Error: / { summary = $0; next }
    /with .+,$/ {
      if (summary != "") {
        addr = $0
        sub(/^.*with /, "", addr)
        sub(/,$/, "", addr)
        print summary "\t" addr
        summary = ""
      }
    }
  ' "$1"
}

# Runs `terraform apply`. If it fails because a resource already exists in
# the cloud but isn't yet tracked in this workspace's state (e.g. left
# behind by a prior interrupted `up`, or a `down` that didn't fully
# complete), imports the existing resource and retries instead of failing
# outright. Falls back to surfacing the original error unchanged when a
# conflict can't be auto-resolved (unrecognized error shape, or
# LAB_TF_AUTO_IMPORT=false).
terraform_apply_reusing_existing() {
  local tf_bin="$1" tf_dir="$2" log_file="$3"
  shift 3
  local apply_args=("$@")

  if [[ "$DRY_RUN" == true ]]; then
    run "$tf_bin" -chdir="$tf_dir" "${apply_args[@]}"
    return 0
  fi

  local var_args=()
  local i
  for ((i = 0; i < ${#apply_args[@]}; i++)); do
    case "${apply_args[$i]}" in
      apply | -auto-approve) ;;
      *) var_args+=("${apply_args[$i]}") ;;
    esac
  done

  local max_attempts=8
  local attempt=1
  while ((attempt <= max_attempts)); do
    printf '+'
    printf ' %q' "$tf_bin" -chdir="$tf_dir" "${apply_args[@]}"
    printf '\n'

    if "$tf_bin" -chdir="$tf_dir" "${apply_args[@]}" -no-color 2>&1 | tee "$log_file"; then
      return 0
    fi

    if [[ "$TF_AUTO_IMPORT" != true ]]; then
      die "terraform apply failed (set LAB_TF_AUTO_IMPORT=true to auto-reuse pre-existing resources; see $log_file)"
    fi

    local imported=0 seen=" "
    while IFS=$'\t' read -r summary addr; do
      [[ "$summary" == *"already exists"* ]] || continue
      [[ "$seen" == *" $addr "* ]] && continue
      seen="$seen$addr "
      terraform_state_has_resource "$tf_bin" "$tf_dir" "$addr" && continue

      local existing_id
      existing_id="$(printf '%s\n' "$summary" | sed -E "s/.*'([^']+)' already exists.*/\1/")"
      [[ -n "$existing_id" && "$existing_id" != "$summary" ]] || continue

      log "'$addr' already exists in the cloud ($existing_id); importing it into Terraform state instead of failing."
      if "$tf_bin" -chdir="$tf_dir" import "${var_args[@]}" "$addr" "$existing_id"; then
        imported=$((imported + 1))
      else
        log "WARNING: could not auto-import $addr; leaving the apply error as-is."
      fi
    done < <(parse_apply_conflicts "$log_file")

    if ((imported == 0)); then
      die "terraform apply failed; see error above (no auto-importable 'already exists' conflicts found; log: $log_file)"
    fi

    attempt=$((attempt + 1))
  done

  die "terraform apply still failing after $max_attempts auto-import attempts; see $log_file"
}

# `up` provisions billable cloud infrastructure (a GKE/EKS/AKS cluster, a
# managed database, ...) *before* `deploy`/`seed`/`benchmark` ever run. A
# missing tool those later stages need -- helm, kubectl, the GKE kubeconfig
# auth plugin, ansible-galaxy, ruby, k6, java -- would otherwise only surface
# as a failure minutes (or tens of minutes) into a live run, after the cloud
# spend and wait are already sunk. Check the whole lifecycle's toolchain up
# front instead, reporting every gap at once rather than one discovery-by-
# failure at a time. See docs/getting-started-benchmark-lab.md#prerequisites
# for install links and version-pinning notes behind each of these.
check_lab_prerequisites() {
  if [[ "$LAB_SKIP_PREFLIGHT" == true ]]; then
    log "Skipping prerequisites check (LAB_SKIP_PREFLIGHT=true)"
    return 0
  fi

  local missing=() warnings=()
  local tf_bin kbin
  tf_bin="$(terraform_bin)"
  kbin="$(kubectl_bin)"

  command -v "$tf_bin" >/dev/null 2>&1 || missing+=("$tf_bin -- Terraform: https://developer.hashicorp.com/terraform/install")
  command -v helm >/dev/null 2>&1 || missing+=("helm -- Helm 3.x, used by 'deploy': https://helm.sh/docs/intro/install/")
  command -v "$kbin" >/dev/null 2>&1 || missing+=("$kbin -- used by 'deploy' readiness checks and cluster access: https://kubernetes.io/docs/tasks/tools/install-kubectl-linux/")
  command -v "${ANSIBLE_PLAYBOOK_BIN:-ansible-playbook}" >/dev/null 2>&1 || missing+=("${ANSIBLE_PLAYBOOK_BIN:-ansible-playbook} -- Ansible, used by 'deploy': https://docs.ansible.com/ansible/latest/installation_guide/intro_installation.html")
  command -v "${ANSIBLE_GALAXY_BIN:-ansible-galaxy}" >/dev/null 2>&1 || missing+=("${ANSIBLE_GALAXY_BIN:-ansible-galaxy} -- bundled with Ansible")
  command -v "${RUBY_BIN:-ruby}" >/dev/null 2>&1 || missing+=("${RUBY_BIN:-ruby} -- used by 'seed'/'benchmark'/'report': https://www.ruby-lang.org/en/documentation/installation/")
  command -v "${K6_BIN:-k6}" >/dev/null 2>&1 || missing+=("${K6_BIN:-k6} -- used by 'benchmark': https://grafana.com/docs/k6/latest/set-up/install-k6/")
  command -v java >/dev/null 2>&1 || missing+=("java 17+ -- used by Synthea seed generation: https://adoptium.net/installation/")

  case "$CLOUD" in
    gcp)
      command -v gcloud >/dev/null 2>&1 || missing+=("gcloud -- GCP CLI: https://cloud.google.com/sdk/docs/install")
      command -v gke-gcloud-auth-plugin >/dev/null 2>&1 || missing+=("gke-gcloud-auth-plugin -- required for kubectl/deploy to authenticate to the GKE cluster 'up' creates: https://cloud.google.com/kubernetes-engine/docs/how-to/cluster-access-for-kubectl#install_plugin")
      if command -v gcloud >/dev/null 2>&1 && ! gcloud auth application-default print-access-token >/dev/null 2>&1; then
        warnings+=("gcloud has no Application Default Credentials -- Terraform will fail to authenticate. Run: gcloud auth application-default login")
      fi
      ;;
    aws)
      command -v aws >/dev/null 2>&1 || missing+=("aws -- AWS CLI: https://docs.aws.amazon.com/cli/latest/userguide/getting-started-install.html")
      ;;
    azure)
      command -v az >/dev/null 2>&1 || missing+=("az -- Azure CLI: https://learn.microsoft.com/en-us/cli/azure/install-azure-cli")
      ;;
  esac

  local w
  for w in "${warnings[@]}"; do
    log "WARNING: $w"
  done

  if ((${#missing[@]})); then
    log "Missing prerequisites for the '$CLOUD' lab lifecycle (up/deploy/seed/benchmark):"
    local item
    for item in "${missing[@]}"; do
      log "  - $item"
    done
    if [[ "$DRY_RUN" == true ]]; then
      log "Dry run: continuing despite missing prerequisites"
    else
      die "install the missing tools above (or set LAB_SKIP_PREFLIGHT=true to bypass this check) before running 'up'"
    fi
  fi
}

cmd_up() {
  require_cloud
  require_name
  check_lab_prerequisites

  local tf_bin
  tf_bin="$(terraform_bin)"
  need_command_unless_dry_run "$tf_bin"

  local tf_dir
  tf_dir="$(terraform_dir)"
  [[ -d "$tf_dir" ]] || die "Terraform module not found: $tf_dir"

  local dir
  dir="$(state_dir)"
  mkdir -p "$dir"

  log "Provisioning $CLOUD lab '$NAME' with Terraform workspace '$NAME'"
  run "$tf_bin" -chdir="$tf_dir" init
  terraform_workspace_ensure "$tf_bin" "$tf_dir"

  local apply_args=("apply" "-var" "lab_name=$NAME")
  if [[ "$AUTO_APPROVE" == true ]]; then
    apply_args+=("-auto-approve")
  fi
  if ((${#TF_VARS[@]})); then
    apply_args+=("${TF_VARS[@]}")
  fi

  if [[ "$CLOUD" == "gcp" && "$TF_AUTO_IMPORT" == true ]]; then
    local sn_var_args=("-var" "lab_name=$NAME")
    if ((${#TF_VARS[@]})); then
      sn_var_args+=("${TF_VARS[@]}")
    fi
    gcp_reuse_service_networking_connection "$tf_bin" "$tf_dir" "${sn_var_args[@]}"
    gcp_reuse_sql_database_instance "$tf_bin" "$tf_dir" "${sn_var_args[@]}"
  fi

  terraform_apply_reusing_existing "$tf_bin" "$tf_dir" "$dir/terraform-apply.log" "${apply_args[@]}"
  write_terraform_outputs "$tf_bin" "$tf_dir" "$dir"
}

cmd_deploy() {
  require_cloud
  require_name

  local state
  state="$(state_dir)"
  local terraform_output_file="${TERRAFORM_OUTPUT_FILE:-$state/terraform-output.json}"
  local kubeconfig_file="$state/kubeconfig"
  if [[ -n "${LAB_KUBECONFIG:-}" ]]; then
    kubeconfig_file="$LAB_KUBECONFIG"
  elif [[ -n "${KUBECONFIG:-}" && "$KUBECONFIG" != *:* ]]; then
    kubeconfig_file="$KUBECONFIG"
  fi

  if [[ "$DRY_RUN" == true ]]; then
    [[ -f "$terraform_output_file" ]] || log "Dry run: Terraform output file is not present yet: $terraform_output_file"
    [[ -f "$kubeconfig_file" ]] || log "Dry run: kubeconfig is not present yet: $kubeconfig_file"
  else
    [[ -f "$terraform_output_file" ]] || die "Terraform output file not found: $terraform_output_file"
    [[ -f "$kubeconfig_file" ]] || die "kubeconfig not found: $kubeconfig_file"
  fi

  local ansible_playbook_bin="${ANSIBLE_PLAYBOOK_BIN:-ansible-playbook}"
  local ansible_galaxy_bin="${ANSIBLE_GALAXY_BIN:-ansible-galaxy}"
  need_command_unless_dry_run "$ansible_playbook_bin"
  need_command_unless_dry_run "$ansible_galaxy_bin"

  local collections_path="$ROOT_DIR/.ansible/collections"
  mkdir -p "$collections_path"

  log "Installing pinned Ansible collections"
  # --force is required here, not optional: without it, ansible-galaxy checks
  # its *default* configured collections path (e.g. ~/.ansible/collections)
  # first, and if the pinned collection is already present there (from an
  # unrelated `ansible-galaxy collection install` run on this machine, with
  # no -p), it prints "Nothing to do. All requested collections are already
  # installed." and skips installing into our project-local $collections_path
  # -- leaving it empty. `deploy` below then scopes ANSIBLE_COLLECTIONS_PATH
  # to only that (now-empty) project-local path, so ansible-playbook fails
  # with "No module named 'ansible_collections.kubernetes'" even though the
  # install step reported success.
  run "$ansible_galaxy_bin" collection install -r "$ROOT_DIR/ansible/requirements.yml" -p "$collections_path" --force

  log "Deploying HAPI FHIR to $CLOUD lab '$NAME' with Ansible"
  local env_args=(
    "ANSIBLE_COLLECTIONS_PATH=$collections_path${ANSIBLE_COLLECTIONS_PATH:+:$ANSIBLE_COLLECTIONS_PATH}"
    "KUBECONFIG=$kubeconfig_file"
    "TERRAFORM_OUTPUT_FILE=$terraform_output_file"
  )
  local playbook_args=(
    -i "$ROOT_DIR/ansible/inventory.ini" \
    "$ROOT_DIR/ansible/playbooks/lab.yml" \
    -e "lab_kubeconfig=$kubeconfig_file" \
    -e "terraform_output_file=$terraform_output_file"
  )
  if ((${#ANSIBLE_EXTRA_VARS[@]})); then
    playbook_args+=("${ANSIBLE_EXTRA_VARS[@]}")
  fi
  run env "${env_args[@]}" "$ansible_playbook_bin" "${playbook_args[@]}"
}

find_synthea() {
  if [[ -n "${SYNTHEA_CMD:-}" ]]; then
    printf '%s' "$SYNTHEA_CMD"
  elif command -v synthea >/dev/null 2>&1; then
    command -v synthea
  elif [[ -n "${SYNTHEA_HOME:-}" && -x "$SYNTHEA_HOME/run_synthea" ]]; then
    printf '%s/run_synthea' "$SYNTHEA_HOME"
  else
    return 1
  fi
}

seed_loader_bin() {
  printf '%s' "${LAB_SEED_LOADER_CMD:-$ROOT_DIR/scripts/synthea_loader.rb}"
}

kubectl_bin() {
  printf '%s' "${KUBECTL_BIN:-kubectl}"
}

shard_output_pvc() {
  printf '%s' "${LAB_SHARD_OUTPUT_PVC:-echis-shard-output}"
}

# Renders a Job manifest template's <ANGLE_BRACKET> placeholder tokens (see
# manifests/seed-job/README.md, manifests/k6-shard-job/README.md) via sed.
# Pass token/value pairs after the template and output paths.
render_job_manifest() {
  local template="$1" rendered="$2"
  shift 2
  (($# % 2 == 0)) || die "render_job_manifest requires an even number of token/value arguments"

  local sed_args=()
  while [[ $# -gt 0 ]]; do
    local token="$1" value="$2"
    # Escape sed's replacement-side special characters (backslash first, so
    # the escapes added for & and | aren't themselves re-escaped) and the
    # s|...|...| delimiter itself, so a value containing any of these (e.g.
    # a FHIR_BASE_URL with a query string) round-trips literally instead of
    # corrupting the rendered manifest.
    local escaped_value="${value//\\/\\\\}"
    escaped_value="${escaped_value//&/\\&}"
    escaped_value="${escaped_value//|/\\|}"
    sed_args+=(-e "s|$token|$escaped_value|g")
    shift 2
  done
  sed "${sed_args[@]}" "$template" > "$rendered"
}

cmd_seed() {
  case "$SEED_GENERATOR_MODE" in
    synthea|native) ;;
    *) die "unsupported LAB_SEED_GENERATOR_MODE '$SEED_GENERATOR_MODE'; expected synthea or native" ;;
  esac

  if [[ "$SEED_GENERATOR_MODE" == "native" ]]; then
    cmd_seed_native
    return 0
  fi

  cmd_seed_synthea
}

cmd_seed_native() {
  [[ -n "$HOUSEHOLDS" ]] || die "--households is required when LAB_SEED_GENERATOR_MODE=native"
  [[ "$HOUSEHOLDS" =~ ^[0-9]+$ ]] || die "--households must be a positive integer"
  [[ "$HOUSEHOLDS" -gt 0 ]] || die "--households must be greater than zero"
  [[ -n "$SEED" ]] || die "--seed is required"
  [[ "$SEED" =~ ^[0-9]+$ ]] || die "--seed must be a non-negative integer"

  if [[ -z "$RUN_ID" ]]; then
    RUN_ID="$(timestamp)-seed"
  fi
  validate_run_id

  if [[ "$IN_CLUSTER" == true ]]; then
    cmd_seed_native_in_cluster
    return 0
  fi

  local dir
  dir="$(run_dir)"
  mkdir -p "$dir"
  local metadata_file="$dir/dataset-metadata.json"
  local loader_cmd="${LAB_ECHIS_SEED_CMD:-$ROOT_DIR/scripts/echis_seed.rb}"
  need_command_unless_dry_run "$loader_cmd"

  if [[ "$GENERATE_ONLY" != true && "$DRY_RUN" != true ]]; then
    [[ -n "${FHIR_BASE_URL:-}" ]] || die "FHIR_BASE_URL is required unless --generate-only is set"
  elif [[ "$GENERATE_ONLY" != true && -z "${FHIR_BASE_URL:-}" ]]; then
    log "Dry run: FHIR_BASE_URL is not set and would be required for import"
  fi

  local loader_args=(
    --households "$HOUSEHOLDS"
    --seed "$SEED"
    --run-id "$RUN_ID"
    --metadata "$metadata_file"
  )
  if [[ -n "$INDIVIDUALS_PER_HOUSEHOLD" ]]; then
    loader_args+=(--individuals-per-household "$INDIVIDUALS_PER_HOUSEHOLD")
  fi
  if [[ "$GENERATE_ONLY" == true ]]; then
    loader_args+=(--metadata-only)
  elif [[ -n "${FHIR_BASE_URL:-}" ]]; then
    loader_args+=(--fhir-base-url "$FHIR_BASE_URL")
  else
    loader_args+=(--fhir-base-url "http://example.invalid/fhir")
  fi

  log "Generating native eCHIS dataset (single process) via $loader_cmd"
  run "$loader_cmd" "${loader_args[@]}"
}

# Renders manifests/seed-job/echis-seed-job.yaml, applies it, and waits for
# completion -- distributing generation across --parallel-shards Kubernetes
# Job pods instead of one local process, per contracts/shard-job.md. The
# final merge step (scripts/merge_seed_shards.rb) is left as a follow-up: it
# needs a path into the shard-output PVC, which is cluster/storage-class
# specific and out of this command's scope (contracts/shard-job.md's own
# Non-goals section defers per-cloud storage sizing/access the same way).
cmd_seed_native_in_cluster() {
  local shard_count="${PARALLEL_SHARDS:-1}"
  [[ "$shard_count" =~ ^[0-9]+$ && "$shard_count" -gt 0 ]] || die "--parallel-shards must be a positive integer"

  local manifest_template="$ROOT_DIR/manifests/seed-job/echis-seed-job.yaml"
  [[ -f "$manifest_template" ]] || die "seed Job manifest not found: $manifest_template"

  local dir
  dir="$(run_dir)"
  mkdir -p "$dir"
  local rendered="$dir/echis-seed-job.rendered.yaml"

  local fhir_base_url="${FHIR_BASE_URL:-}"
  if [[ -z "$fhir_base_url" ]]; then
    [[ "$GENERATE_ONLY" == true ]] || die "FHIR_BASE_URL is required for --in-cluster unless --generate-only is set"
    fhir_base_url="http://example.invalid/fhir"
  fi

  local individuals_per_household="${INDIVIDUALS_PER_HOUSEHOLD:-3}"
  local configmap_name="echis-seed-job-scripts"
  local pvc_name
  pvc_name="$(shard_output_pvc)"

  log "Rendering $manifest_template for $shard_count shard(s)"
  render_job_manifest "$manifest_template" "$rendered" \
    "<SHARD_COUNT>" "$shard_count" \
    "<HOUSEHOLDS_TOTAL>" "$HOUSEHOLDS" \
    "<INDIVIDUALS_PER_HOUSEHOLD>" "$individuals_per_household" \
    "<SEED>" "$SEED" \
    "<RUN_ID>" "$RUN_ID" \
    "<FHIR_BASE_URL>" "$fhir_base_url" \
    "<SEED_SCRIPTS_CONFIGMAP>" "$configmap_name" \
    "<SHARD_OUTPUT_PVC>" "$pvc_name"

  local kbin
  kbin="$(kubectl_bin)"
  need_command_unless_dry_run "$kbin"

  log "Creating/updating ConfigMap $configmap_name from scripts/echis_seed.rb"
  run bash -c "set -euo pipefail; \"$kbin\" create configmap \"$configmap_name\" --from-file=echis_seed.rb=\"$ROOT_DIR/scripts/echis_seed.rb\" --from-file=minimal_fhir_seed.rb=\"$ROOT_DIR/scripts/minimal_fhir_seed.rb\" -n fhir --dry-run=client -o yaml | \"$kbin\" apply -f -"

  log "Applying rendered seed Job: $rendered"
  run "$kbin" apply -f "$rendered"

  log "Waiting for seed Job to complete ($shard_count shard(s))"
  run "$kbin" wait --for=condition=complete job/echis-seed-job -n fhir --timeout=3600s

  log "Job complete. Shard output lives on PVC $pvc_name; merge with:"
  log "  ruby scripts/merge_seed_shards.rb --shard-dir <path into PVC $pvc_name> --shard-count $shard_count --output $dir/dataset-metadata.json"
}

cmd_seed_synthea() {
  [[ -n "$PATIENTS" ]] || die "--patients is required"
  [[ "$PATIENTS" =~ ^[0-9]+$ ]] || die "--patients must be a positive integer"
  [[ "$PATIENTS" -gt 0 ]] || die "--patients must be greater than zero"
  [[ -n "$SEED" ]] || die "--seed is required"
  [[ "$SEED" =~ ^[0-9]+$ ]] || die "--seed must be a non-negative integer"

  if [[ -z "$RUN_ID" ]]; then
    RUN_ID="$(timestamp)-seed"
  fi
  validate_run_id

  local dir
  dir="$(run_dir)"
  local dataset_dir="$dir/synthea"
  mkdir -p "$dataset_dir"

  local metadata_file="$dir/dataset-metadata.json"
  local loader_cmd
  loader_cmd="$(seed_loader_bin)"
  need_command_unless_dry_run "$loader_cmd"

  if [[ "$GENERATE_ONLY" != true && "$DRY_RUN" != true ]]; then
    [[ -n "${FHIR_BASE_URL:-}" ]] || die "FHIR_BASE_URL is required unless --generate-only is set"
  elif [[ "$GENERATE_ONLY" != true && -z "${FHIR_BASE_URL:-}" ]]; then
    log "Dry run: FHIR_BASE_URL is not set and would be required for import"
  fi

  local synthea_cmd
  if ! synthea_cmd="$(find_synthea)"; then
    if [[ "$DRY_RUN" == true ]]; then
      synthea_cmd="${SYNTHEA_CMD:-synthea}"
      log "Dry run: skipping missing Synthea command check for $synthea_cmd"
    else
      die "Synthea not found; set SYNTHEA_CMD or SYNTHEA_HOME"
    fi
  fi

  local synthea_config="${SYNTHEA_CONFIG:-$ROOT_DIR/benchmarks/synthea/synthea.properties}"
  local synthea_args=()
  if [[ -f "$synthea_config" ]]; then
    synthea_args+=("-c" "$synthea_config")
  fi
  synthea_args+=(
    -p "$PATIENTS"
    -s "$SEED"
    --exporter.fhir.export=true
    --exporter.fhir.transaction_bundle=true
    --exporter.baseDirectory="$dataset_dir"
  )

  log "Generating Synthea dataset in $dataset_dir"
  run "$synthea_cmd" "${synthea_args[@]}"

  local loader_args=(
    --input "$dataset_dir"
    --metadata "$metadata_file"
    --patients "$PATIENTS"
    --seed "$SEED"
    --run-id "$RUN_ID"
  )
  if [[ "$GENERATE_ONLY" == true ]]; then
    loader_args+=(--metadata-only)
  elif [[ -n "${FHIR_BASE_URL:-}" ]]; then
    loader_args+=(--fhir-base-url "$FHIR_BASE_URL")
  else
    loader_args+=(--fhir-base-url "http://example.invalid/fhir")
  fi

  log "Recording dataset metadata and loading transaction bundles"
  run "$loader_cmd" "${loader_args[@]}"
}

echis_tier_order() {
  case "$1" in
    T2) echo 2 ;;
    T3) echo 3 ;;
    T4) echo 4 ;;
    T5) echo 5 ;;
    *) die "unsupported --echis-tier '$1'; expected T2, T3, T4, or T5" ;;
  esac
}

echis_tier_progress_file() {
  printf '%s/echis-tier-progress.json' "$ARTIFACT_ROOT"
}

echis_tier_progress_has() {
  local progress_file="$1"
  local tier="$2"
  "${RUBY_BIN:-ruby}" -rjson -e '
    path, tier = ARGV
    completed = JSON.parse(File.read(path))["completed_tiers"] || []
    exit(completed.include?(tier) ? 0 : 1)
  ' "$progress_file" "$tier" 2>/dev/null
}

require_echis_tier_sequence() {
  local tier="$1"
  local order
  order="$(echis_tier_order "$tier")"

  if [[ "$order" -ge 4 ]]; then
    if [[ "${LAB_ECHIS_POOLED_TIER_CONFIRMED:-}" != "true" ]]; then
      if [[ "$DRY_RUN" == true ]]; then
        log "Dry run: LAB_ECHIS_POOLED_TIER_CONFIRMED is not set to true; tier $tier would be refused (requires the PgBouncer pooled connection tier from spec 007)"
      else
        die "tier $tier requires the PgBouncer pooled connection tier (spec 007) to be deployed and validated; set LAB_ECHIS_POOLED_TIER_CONFIRMED=true once enable_pgbouncer has been applied, per docs/echis-benchmark-tiers.md"
      fi
    fi
  fi

  if [[ "$order" -le 2 ]]; then
    return 0
  fi

  local progress_file prev_tier
  progress_file="$(echis_tier_progress_file)"
  prev_tier="T$((order - 1))"

  if [[ "$DRY_RUN" == true ]]; then
    [[ -f "$progress_file" ]] || log "Dry run: tier progress file not present yet: $progress_file (would require prior tier $prev_tier to be recorded)"
    return 0
  fi

  [[ -f "$progress_file" ]] || die "tier $tier requires tier $prev_tier to have completed first; no progress recorded at $progress_file"
  echis_tier_progress_has "$progress_file" "$prev_tier" ||
    die "tier $tier requires tier $prev_tier to have completed first; $prev_tier not found in $progress_file"
}

record_echis_tier_progress() {
  local tier="$1"
  local progress_file
  progress_file="$(echis_tier_progress_file)"

  if [[ "$DRY_RUN" == true ]]; then
    log "Dry run: would record tier $tier completion in $progress_file"
    return 0
  fi

  mkdir -p "$(dirname "$progress_file")"
  "${RUBY_BIN:-ruby}" -rjson -e '
    path, tier = ARGV
    completed = File.exist?(path) ? (JSON.parse(File.read(path))["completed_tiers"] || []) : []
    completed << tier unless completed.include?(tier)
    File.write(path, "#{JSON.pretty_generate({"completed_tiers" => completed})}\n")
  ' "$progress_file" "$tier"
}

# Renders manifests/k6-shard-job/echis-k6-shard-job.yaml, applies it, and
# waits for completion -- distributing k6 load generation across
# --parallel-shards Kubernetes Job pods instead of one local k6 process, per
# contracts/shard-job.md. Always targets benchmarks/k6/echis_load_100.js,
# matching the manifest's own hardcoded ConfigMap items -- see
# manifests/k6-shard-job/README.md's sharding strategy note (aggregate
# concurrency is that script's own VU target multiplied by shard count).
# K6_SCRIPT is intentionally not honored here since the manifest's ConfigMap
# item mapping is static; retargeting requires updating both together. The
# final merge step (scripts/merge_k6_shards.rb) is left as a follow-up, same
# reason as cmd_seed_native_in_cluster.
cmd_benchmark_in_cluster() {
  local shard_count="${PARALLEL_SHARDS:-1}"
  [[ "$shard_count" =~ ^[0-9]+$ && "$shard_count" -gt 0 ]] || die "--parallel-shards must be a positive integer"

  local manifest_template="$ROOT_DIR/manifests/k6-shard-job/echis-k6-shard-job.yaml"
  [[ -f "$manifest_template" ]] || die "k6 shard Job manifest not found: $manifest_template"

  local dir
  dir="$(run_dir)"
  mkdir -p "$dir"
  local rendered="$dir/echis-k6-shard-job.rendered.yaml"
  local configmap_name="echis-k6-shard-job-scripts"
  local pvc_name
  pvc_name="$(shard_output_pvc)"
  local k6_script="$ROOT_DIR/benchmarks/k6/echis_load_100.js"
  [[ -f "$k6_script" ]] || die "k6 script not found: $k6_script"
  if [[ -n "${K6_SCRIPT:-}" && "$K6_SCRIPT" != "$k6_script" ]]; then
    die "K6_SCRIPT is set to '$K6_SCRIPT' but --in-cluster always targets $k6_script (the manifest's ConfigMap items are static, per manifests/k6-shard-job/README.md's sharding strategy); unset K6_SCRIPT, or retarget both the manifest and this command together"
  fi

  log "Rendering $manifest_template for $shard_count shard(s)"
  render_job_manifest "$manifest_template" "$rendered" \
    "<SHARD_COUNT>" "$shard_count" \
    "<FHIR_BASE_URL>" "$FHIR_BASE_URL" \
    "<K6_SCRIPTS_CONFIGMAP>" "$configmap_name" \
    "<SHARD_OUTPUT_PVC>" "$pvc_name"

  local kbin
  kbin="$(kubectl_bin)"
  need_command_unless_dry_run "$kbin"

  log "Creating/updating ConfigMap $configmap_name from $k6_script"
  run bash -c "set -euo pipefail; \"$kbin\" create configmap \"$configmap_name\" --from-file=echis_load_100.js=\"$k6_script\" --from-file=fhir_benchmark.js=\"$ROOT_DIR/benchmarks/k6/lib/fhir_benchmark.js\" -n fhir --dry-run=client -o yaml | \"$kbin\" apply -f -"

  log "Applying rendered k6 shard Job: $rendered"
  run "$kbin" apply -f "$rendered"

  log "Waiting for k6 shard Job to complete ($shard_count shard(s))"
  run "$kbin" wait --for=condition=complete job/echis-k6-shard-job -n fhir --timeout=7200s

  log "Job complete. Shard output lives on PVC $pvc_name; merge with:"
  log "  ruby scripts/merge_k6_shards.rb --shard-dir <path into PVC $pvc_name> --shard-count $shard_count --output $dir/k6-fhir-summary.json"
}

cmd_benchmark() {
  require_profile
  if [[ -n "$ECHIS_TIER" ]]; then
    require_echis_tier_sequence "$ECHIS_TIER"
  fi

  if [[ -z "$RUN_ID" ]]; then
    RUN_ID="$(timestamp)-${PROFILE}"
  fi
  validate_run_id
  [[ -n "${FHIR_BASE_URL:-}" ]] || die "FHIR_BASE_URL is required for benchmark"

  if [[ "$IN_CLUSTER" == true ]]; then
    cmd_benchmark_in_cluster
    if [[ -n "$ECHIS_TIER" ]]; then
      record_echis_tier_progress "$ECHIS_TIER"
    fi
    return 0
  fi

  local k6_bin="${K6_BIN:-k6}"
  need_command_unless_dry_run "$k6_bin"
  local ruby_bin="${RUBY_BIN:-ruby}"
  need_command_unless_dry_run "$ruby_bin"

  local script="${K6_SCRIPT:-$ROOT_DIR/benchmarks/k6/$PROFILE.js}"
  if [[ "$DRY_RUN" == true ]]; then
    [[ -f "$script" ]] || log "Dry run: k6 script is not present yet: $script"
  else
    [[ -f "$script" ]] || die "k6 script not found: $script; set K6_SCRIPT or add benchmark profiles from issue #23"
  fi

  local dir
  dir="$(run_dir)"
  mkdir -p "$dir"
  local metadata_file="$dir/benchmark-metadata.json"
  local prometheus_present=false
  if [[ -n "${PROMETHEUS_BASE_URL:-}" ]]; then
    prometheus_present=true
  fi

  log "Running k6 $PROFILE benchmark against $FHIR_BASE_URL"
  run "$ruby_bin" -rjson -e '
    path, run_id, profile, fhir_base_url, bulk_export_enabled, prometheus_present, created_at, cloud = ARGV
    data = {
      "run_id" => run_id,
      "profile" => profile,
      "fhir_base_url" => fhir_base_url,
      "bulk_export_enabled" => bulk_export_enabled == "true",
      "prometheus_base_url_present" => prometheus_present == "true",
      "created_at_utc" => created_at
    }
    data["cloud"] = cloud unless cloud.to_s.empty?
    File.write(path, "#{JSON.pretty_generate(data)}\n")
  ' "$metadata_file" "$RUN_ID" "$PROFILE" "$FHIR_BASE_URL" "${BULK_EXPORT_ENABLED:-false}" "$prometheus_present" "$(date -u +%FT%TZ)" "$CLOUD"
  # K6_PROMETHEUS_RW_SERVER_URL is a k6-native env var (only configures the
  # remote-write target's URL); k6 still needs -o experimental-prometheus-rw
  # on the command line to actually select that output. Requires the
  # target Prometheus to have enableRemoteWriteReceiver on (see
  # ansible/group_vars/lab.yml's enable_prometheus_remote_write, default
  # true) -- lets this run's load/latency/failure-rate be watched live in
  # Grafana instead of only from the post-run k6 JSON summary.
  local k6_out_args=(--out "json=$dir/k6-raw.jsonl")
  if [[ -n "${K6_PROMETHEUS_RW_SERVER_URL:-}" ]]; then
    k6_out_args+=(--out experimental-prometheus-rw)
    log "Also streaming live k6 metrics to Prometheus remote-write at $K6_PROMETHEUS_RW_SERVER_URL"
  fi

  run "$k6_bin" run \
    -e "FHIR_BASE_URL=$FHIR_BASE_URL" \
    -e "PROFILE=$PROFILE" \
    -e "K6_FHIR_SUMMARY_PATH=$dir/k6-fhir-summary.json" \
    "${k6_out_args[@]}" \
    --summary-export "$dir/k6-summary.json" \
    "$script"

  if [[ -n "$ECHIS_TIER" ]]; then
    record_echis_tier_progress "$ECHIS_TIER"
  fi
}

cmd_report() {
  require_run
  if [[ -n "$CLOUD" ]]; then
    require_cloud
  fi
  if [[ -n "$NAME" ]]; then
    require_name
  fi
  if [[ -n "$PROFILE" ]]; then
    require_profile
  fi

  local dir
  dir="$(run_dir)"
  [[ -d "$dir" ]] || die "run directory not found: $dir"

  local report_path="$dir/report.md"
  if [[ -n "${LAB_REPORT_CMD:-}" ]]; then
    log "Generating report with LAB_REPORT_CMD"
    run "$LAB_REPORT_CMD" "$dir" "$report_path"
    return 0
  fi

  local publisher_cmd=()
  if [[ -n "${LAB_RESULT_PUBLISHER_CMD:-}" ]]; then
    need_command_unless_dry_run "$LAB_RESULT_PUBLISHER_CMD"
    publisher_cmd=("$LAB_RESULT_PUBLISHER_CMD")
  else
    local ruby_bin="${RUBY_BIN:-ruby}"
    local default_publisher="$ROOT_DIR/scripts/publish_results.rb"
    need_command_unless_dry_run "$ruby_bin"
    [[ -f "$default_publisher" ]] || die "default result publisher not found: $default_publisher"
    publisher_cmd=("$ruby_bin" "$default_publisher")
  fi

  local publisher_args=(
    --run-dir "$dir"
    --run-id "$RUN_ID"
    --results-root "$RESULT_ROOT"
  )
  if [[ -n "$CLOUD" ]]; then
    publisher_args+=(--cloud "$CLOUD")
  fi
  if [[ -n "$PROFILE" ]]; then
    publisher_args+=(--profile "$PROFILE")
  fi

  local terraform_output_file="${TERRAFORM_OUTPUT_FILE:-}"
  if [[ -z "$terraform_output_file" && -n "$CLOUD" && -n "$NAME" ]]; then
    terraform_output_file="$(state_dir)/terraform-output.json"
  fi
  if [[ -n "$terraform_output_file" && -f "$terraform_output_file" ]]; then
    publisher_args+=(--terraform-output "$terraform_output_file")
  elif [[ "$DRY_RUN" == true && -n "$terraform_output_file" ]]; then
    log "Dry run: Terraform output file is not present yet: $terraform_output_file"
  fi

  local deployment_metadata_file="${DEPLOYMENT_METADATA_FILE:-$ROOT_DIR/ansible/artifacts/deployment-metadata.json}"
  if [[ -f "$deployment_metadata_file" ]]; then
    publisher_args+=(--deployment-metadata "$deployment_metadata_file")
  elif [[ "$DRY_RUN" == true ]]; then
    log "Dry run: deployment metadata file is not present yet: $deployment_metadata_file"
  fi

  log "Publishing benchmark results under $RESULT_ROOT"
  run "${publisher_cmd[@]}" "${publisher_args[@]}"
}

confirm_destroy() {
  if [[ "$YES" == true ]]; then
    return 0
  fi

  printf 'Destroying lab resources can delete data and is required to stop cloud cost.\n' >&2
  printf 'Type the lab name "%s" to destroy %s resources: ' "$NAME" "$CLOUD" >&2
  local answer=""
  read -r answer || die "destroy confirmation failed"
  [[ "$answer" == "$NAME" ]] || die "destroy cancelled"
}

public_exposure_state_file() {
  local slug="$1"
  printf '%s/%s-public-exposure.env' "$(state_dir)" "$slug"
}

# Best-effort public-IP self-lookup of *this host* (where scripts/lab is
# running), used only to print the URL an expose-* command is reachable at --
# never as a --source-ranges default (see expose_public_service's comment on
# why "detect the caller's IP" isn't a meaningful security scope here). Tries
# a couple of independent echo services so one outage doesn't block the whole
# command; callers must tolerate this failing (falls back to a placeholder).
detect_public_ip() {
  local url ip
  for url in "https://api.ipify.org" "https://ifconfig.me" "https://icanhazip.com"; do
    ip="$(curl -fsS --max-time 5 "$url" 2>/dev/null | tr -d '[:space:]')"
    if [[ "$ip" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
      printf '%s' "$ip"
      return 0
    fi
  done
  return 1
}

# Shared implementation behind expose-fhir/expose-prometheus (and any future
# expose-<service> command): opens a GCP firewall rule and a 0.0.0.0-bound
# `kubectl port-forward` for one Kubernetes Service, so it's reachable from
# outside the host running `scripts/lab` (e.g. at a GCE control-plane VM's
# own public IP), not just via an SSH/VS Code tunnel.
#
# --source-ranges defaults to 0.0.0.0/0 (the whole internet), not a detected
# "caller" IP: `scripts/lab` normally runs *on* the GCE VM itself (via
# SSH/VS Code Remote), so auto-detecting "my public IP" from that same VM
# detects the VM's own address, not the browser/laptop that's actually
# trying to reach it -- a restrictive default that doesn't match the real
# client just breaks access silently. Pass a narrower --source-ranges (e.g.
# your own IP/32) if you want it restricted. Not every service this wraps
# has auth in front of it in this lab -- HAPI FHIR and Prometheus don't,
# Grafana does (login required) -- check the specific expose-* command.
#
# state_slug: state-file/log-file name component (e.g. "fhir", "prometheus").
# rule_prefix: firewall-rule name component (kept distinct from state_slug
#   for fhir's sake, to preserve the firewall rule name already in use:
#   allow-hapi-fhir-<port>-<lab>, not allow-fhir-<port>-<lab>).
# target_port: the Service's actual port (not user-overridable -- it has to
#   match the Service, and is always used as-is on the port-forward's
#   Kubernetes-facing side).
# display_name: human-readable name for log messages (e.g. "HAPI FHIR"),
#   kept distinct from the Kubernetes Service name (svc).
# url_path (optional): path suffix for the printed reachable-at URL, e.g.
#   "/fhir" for HAPI FHIR's REST API base path. Empty for a bare root UI
#   like Prometheus's/Grafana's.
# default_external_port (optional, defaults to target_port): the port
#   --port defaults to for the *local*/firewall side. Distinct from
#   target_port because that side needs CAP_NET_BIND_SERVICE/root for any
#   port below 1024 (e.g. Grafana's Service port 80) -- defaulting the
#   externally-exposed port to a privileged one would fail for every
#   non-root caller, so a service whose real port is privileged should pass
#   a sane unprivileged default here instead (Grafana passes 3000).
expose_public_service() {
  local state_slug="$1" rule_prefix="$2" target_port="$3" ns="$4" svc="$5" display_name="$6" url_path="${7:-}"
  # Not folded into the `local` line above: a variable assigned earlier in
  # the same `local` statement isn't visible to a later one's default-value
  # expansion in bash (all word expansions happen before any assignment).
  local default_external_port="${8:-$target_port}"

  require_cloud
  require_name
  [[ "$CLOUD" == "gcp" ]] || die "expose-$state_slug is currently GCP-only; see docs/gcp-echis-t3-lab-runbook.md for the manual steps to adapt this for aws/azure"

  need_command_unless_dry_run gcloud
  local kbin
  kbin="$(kubectl_bin)"
  need_command_unless_dry_run "$kbin"

  local project_id
  project_id="$(tf_var_get project_id)" || die "expose-$state_slug requires --var project_id=PROJECT_ID"

  local port="${PORT:-$default_external_port}"
  local source_ranges="${SOURCE_RANGES:-0.0.0.0/0}"
  if [[ "$source_ranges" == "0.0.0.0/0" ]]; then
    log "Opening firewall rule to the entire internet (0.0.0.0/0, the default). Pass --source-ranges CIDR to restrict it (e.g. to your own IP/32)."
  else
    log "Restricting firewall rule to $source_ranges"
  fi

  local firewall_rule="allow-${rule_prefix}-${port}-${NAME}"

  local rule_exists=false
  if [[ "$DRY_RUN" != true ]] && gcloud compute firewall-rules describe "$firewall_rule" --project "$project_id" >/dev/null 2>&1; then
    rule_exists=true
  fi

  log "$([[ "$rule_exists" == true ]] && echo Updating || echo Creating) GCP firewall rule '$firewall_rule' (tcp:$port from $source_ranges)"
  if [[ "$rule_exists" == true ]]; then
    run gcloud compute firewall-rules update "$firewall_rule" --project "$project_id" --source-ranges="$source_ranges"
  else
    run gcloud compute firewall-rules create "$firewall_rule" \
      --project "$project_id" \
      --direction=INGRESS \
      --action=ALLOW \
      --rules="tcp:$port" \
      --source-ranges="$source_ranges" \
      --description="scripts/lab expose-$state_slug: public access to $display_name ($svc) in lab '$NAME'. Run 'scripts/lab unexpose-$state_slug' or 'scripts/lab down' to remove."
  fi

  local state_file
  state_file="$(public_exposure_state_file "$state_slug")"
  local old_pid
  old_pid="$(grep -m1 '^PORT_FORWARD_PID=' "$state_file" 2>/dev/null | cut -d= -f2)" || true
  if [[ -n "$old_pid" ]] && kill -0 "$old_pid" 2>/dev/null; then
    log "Stopping previous exposed port-forward (pid $old_pid)"
    run kill "$old_pid"
  fi

  mkdir -p "$(state_dir)"
  local pf_log="$(state_dir)/${state_slug}-public-portforward.log"

  if [[ "$DRY_RUN" == true ]]; then
    run "$kbin" -n "$ns" port-forward --address 0.0.0.0 "svc/$svc" "$port:$target_port"
    return 0
  fi

  nohup "$kbin" -n "$ns" port-forward --address 0.0.0.0 "svc/$svc" "$port:$target_port" >"$pf_log" 2>&1 &
  local pf_pid=$!
  disown
  sleep 2
  kill -0 "$pf_pid" 2>/dev/null || die "port-forward failed to start; see $pf_log"

  {
    printf 'FIREWALL_RULE=%s\n' "$firewall_rule"
    printf 'PORT=%s\n' "$port"
    printf 'PORT_FORWARD_PID=%s\n' "$pf_pid"
    printf 'PROJECT_ID=%s\n' "$project_id"
  } >"$state_file"

  local display_ip
  display_ip="$(detect_public_ip 2>/dev/null || echo '<this host'"'"'s public IP>')"
  log "$display_name is reachable at http://${display_ip}:${port}${url_path} (firewall rule '$firewall_rule', port-forward pid $pf_pid)"
  log "Run 'scripts/lab unexpose-$state_slug --cloud gcp --name $NAME --var project_id=$project_id' to close this early, or 'down' cleans it up automatically."
}

# Reverse of expose_public_service: kills the tracked port-forward and
# deletes the firewall rule. Safe to call even when nothing is currently
# exposed (no-op). Arguments match expose_public_service's state_slug,
# rule_prefix, default_external_port (the latter only used to compute a
# fallback firewall-rule name when no state file was ever written -- pass
# the same value given to the matching expose_public_service call).
unexpose_public_service() {
  local state_slug="$1" rule_prefix="$2" default_external_port="$3"

  require_cloud
  require_name
  if [[ "$CLOUD" != "gcp" ]]; then
    log "unexpose-$state_slug is GCP-only; nothing to do for $CLOUD"
    return 0
  fi

  local state_file
  state_file="$(public_exposure_state_file "$state_slug")"

  local firewall_rule="" pf_pid="" project_id=""
  if [[ -f "$state_file" ]]; then
    firewall_rule="$(grep -m1 '^FIREWALL_RULE=' "$state_file" | cut -d= -f2)" || true
    pf_pid="$(grep -m1 '^PORT_FORWARD_PID=' "$state_file" | cut -d= -f2)" || true
    project_id="$(grep -m1 '^PROJECT_ID=' "$state_file" | cut -d= -f2)" || true
  fi
  [[ -n "$project_id" ]] || project_id="$(tf_var_get project_id)" || true
  [[ -n "$firewall_rule" ]] || firewall_rule="allow-${rule_prefix}-${PORT:-$default_external_port}-${NAME}"

  if [[ -n "$pf_pid" ]] && kill -0 "$pf_pid" 2>/dev/null; then
    log "Stopping exposed port-forward (pid $pf_pid)"
    run kill "$pf_pid"
  fi

  local project_flag=()
  [[ -n "$project_id" ]] && project_flag=(--project "$project_id")

  if [[ "$DRY_RUN" != true ]] && ! gcloud compute firewall-rules describe "$firewall_rule" "${project_flag[@]}" >/dev/null 2>&1; then
    log "Firewall rule '$firewall_rule' not found (already removed or never created); nothing to delete"
  else
    run gcloud compute firewall-rules delete "$firewall_rule" "${project_flag[@]}" --quiet
  fi

  rm -f "$state_file"
}

cmd_expose_fhir() {
  expose_public_service fhir hapi-fhir 8080 "${HAPI_NAMESPACE:-fhir}" "${HAPI_SERVICE_NAME:-hapi-fhir-hapi-fhir-jpaserver}" "HAPI FHIR" "/fhir"
}

cmd_unexpose_fhir() {
  unexpose_public_service fhir hapi-fhir 8080
}

cmd_expose_prometheus() {
  expose_public_service prometheus prometheus 9090 "${PROMETHEUS_NAMESPACE:-monitoring}" "${PROMETHEUS_SERVICE_NAME:-prometheus-kube-prometheus-prometheus}" "Prometheus"
}

cmd_unexpose_prometheus() {
  unexpose_public_service prometheus prometheus 9090
}

cmd_expose_grafana() {
  # target_port 80 is the Grafana Service's real port; default_external_port
  # 3000 (Grafana's own conventional UI port) is what --port defaults to
  # locally, since binding the literal privileged port 80 needs root.
  expose_public_service grafana grafana 80 "${GRAFANA_NAMESPACE:-monitoring}" "${GRAFANA_SERVICE_NAME:-prometheus-grafana}" "Grafana" "" 3000
}

cmd_unexpose_grafana() {
  unexpose_public_service grafana grafana 3000
}

cmd_down() {
  require_cloud
  require_name

  if [[ "$CLOUD" == "gcp" ]]; then
    log "Cleaning up any public exposure from 'expose-fhir'/'expose-prometheus'/'expose-grafana' before destroying infrastructure"
    cmd_unexpose_fhir || log "WARNING: could not fully clean up public FHIR exposure (see above); continuing with destroy anyway"
    cmd_unexpose_prometheus || log "WARNING: could not fully clean up public Prometheus exposure (see above); continuing with destroy anyway"
    cmd_unexpose_grafana || log "WARNING: could not fully clean up public Grafana exposure (see above); continuing with destroy anyway"
  fi

  local tf_bin
  tf_bin="$(terraform_bin)"
  need_command_unless_dry_run "$tf_bin"

  local tf_dir
  tf_dir="$(terraform_dir)"
  [[ -d "$tf_dir" ]] || die "Terraform module not found: $tf_dir"

  log "Preparing to destroy $CLOUD lab '$NAME'"
  run "$tf_bin" -chdir="$tf_dir" init
  terraform_workspace_select "$tf_bin" "$tf_dir"
  confirm_destroy

  local destroy_args=("destroy" "-var" "lab_name=$NAME")
  if [[ "$YES" == true || "$AUTO_APPROVE" == true ]]; then
    destroy_args+=("-auto-approve")
  fi
  if ((${#TF_VARS[@]})); then
    destroy_args+=("${TF_VARS[@]}")
  fi

  run "$tf_bin" -chdir="$tf_dir" "${destroy_args[@]}"
  log "Destroy completed for $CLOUD lab '$NAME'"
}

# The KEDA ScaledObject is named hapi-fhir-jpaserver whether the native or
# pooled connection tier is applied -- ansible/playbooks/20-deploy-hapi-fhir.yml
# applies exactly one of the two, never both, under this same name, so one
# pair of commands covers both tiers.
autoscaling_namespace() {
  printf '%s' "${HAPI_NAMESPACE:-fhir}"
}

# Per docs/autoscaling.md's "Bulk Data-Load Window Procedure" (spec 007 US3,
# research.md Decision 6): pins the replica count for a one-time bulk
# data-load window via KEDA's autoscaling.keda.sh/paused-replicas annotation
# (the real KEDA v2 mechanism -- there is no spec.paused field on the
# ScaledObject CRD). This sets the underlying HPA's min/max to the given
# value, overriding live-metric-driven scaling until resume-autoscaling
# removes the annotation.
cmd_pause_autoscaling() {
  [[ -n "$REPLICAS" ]] || die "--replicas is required"
  [[ "$REPLICAS" =~ ^[0-9]+$ ]] || die "--replicas must be a positive integer"
  [[ "$REPLICAS" -gt 0 ]] || die "--replicas must be greater than zero"

  local kbin
  kbin="$(kubectl_bin)"
  need_command_unless_dry_run "$kbin"

  local ns
  ns="$(autoscaling_namespace)"
  log "Pinning hapi-fhir-jpaserver to $REPLICAS replica(s) for a bulk data-load window (namespace $ns)"
  run "$kbin" -n "$ns" annotate scaledobject hapi-fhir-jpaserver \
    "autoscaling.keda.sh/paused-replicas=$REPLICAS" --overwrite
}

cmd_resume_autoscaling() {
  local kbin
  kbin="$(kubectl_bin)"
  need_command_unless_dry_run "$kbin"

  local ns
  ns="$(autoscaling_namespace)"
  log "Removing the replica pin so KEDA resumes live-metric-driven autoscaling (namespace $ns)"
  run "$kbin" -n "$ns" annotate scaledobject hapi-fhir-jpaserver "autoscaling.keda.sh/paused-replicas-"
}

if [[ -z "$COMMAND" || "$COMMAND" == "-h" || "$COMMAND" == "--help" ]]; then
  usage
  exit 0
fi

parse_args "$@"

case "$COMMAND" in
  up) cmd_up ;;
  deploy) cmd_deploy ;;
  seed) cmd_seed ;;
  benchmark) cmd_benchmark ;;
  report) cmd_report ;;
  down) cmd_down ;;
  pause-autoscaling) cmd_pause_autoscaling ;;
  resume-autoscaling) cmd_resume_autoscaling ;;
  expose-fhir) cmd_expose_fhir ;;
  unexpose-fhir) cmd_unexpose_fhir ;;
  expose-prometheus) cmd_expose_prometheus ;;
  unexpose-prometheus) cmd_unexpose_prometheus ;;
  expose-grafana) cmd_expose_grafana ;;
  unexpose-grafana) cmd_unexpose_grafana ;;
  help) usage ;;
  *) die "unknown command: $COMMAND" ;;
esac
